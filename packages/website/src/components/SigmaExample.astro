---
/**
 * Embeds a sigma.js example in a Starlight docs page.
 *
 * Usage in MDX:
 *   <SigmaExample id="core/events" />
 *   <SigmaExample id="get-started/quickstart" defaultTab="source" />
 *   <SigmaExample id="cookbook/export-image" controls />
 *
 * Props:
 *   id         - must match a file at src/examples/{id}.astro
 *   height     - iframe height (default "500px")
 *   defaultTab - which tab to show first: "result" (default) or "source"
 *   controls   - keep the example's controls bar visible (hidden by default,
 *                for examples whose controls *are* the demo)
 */
import { Code } from "astro-expressive-code/components";
import { Icon } from "astro-icon/components";

interface Props {
  id: string;
  height?: string;
  defaultTab?: "result" | "source";
  controls?: boolean;
}

const { id, height = "500px", defaultTab = "result", controls = false } = Astro.props;

let scriptSource = "";
const sources = import.meta.glob("../examples/**/*.astro", { query: "?raw", eager: true });
const key = Object.keys(sources).find((k) => k.includes(`/${id}.astro`));
if (key) {
  const raw = (sources[key] as { default: string }).default;
  const match = raw.match(/<script[^>]*>([\s\S]*?)<\/script>/);
  if (match) {
    scriptSource = match[1].replace(/^\n/, "").replace(/\n$/, "").replace(/^  /gm, "");
  }
}

const sourceFirst = defaultTab === "source";
---

<div class="sigma-example not-content" style={`--panel-height: ${height}`}>
  <div class={`sigma-example-panel sigma-example-result ${sourceFirst ? "" : "active"}`} data-panel="result">
    <iframe
      src={`/embed/${id}/?stage-only${controls ? "&controls" : ""}`}
      title={`sigma.js example: ${id}`}
      loading="lazy"></iframe>
  </div>
  <div class={`sigma-example-panel sigma-example-source ${sourceFirst ? "active" : ""}`} data-panel="source">
    <Code code={scriptSource} lang="typescript" />
  </div>
  <div class="example-toolbar">
    <div class="example-toolbar-controls">
      <button class={`example-toolbar-control ${sourceFirst ? "" : "active"}`} data-tab="result"> Result </button>
      <button class={`example-toolbar-control ${sourceFirst ? "active" : ""}`} data-tab="source"> Source </button>
    </div>
    <div class="example-toolbar-links">
      <a
        href={`https://github.com/jacomyal/sigma.js/blob/v4/packages/website/src/examples/${id}.astro`}
        target="_blank"
        rel="noopener"><Icon name="ph:github-logo-bold" class="toolbar-link-icon" />View source</a
      >
      <span class="example-toolbar-sep"></span>
      <a href={`/embed/${id}/`} target="_blank" rel="noopener"
        ><Icon name="ph:arrow-square-in-bold" class="toolbar-link-icon" />Open</a
      >
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".sigma-example").forEach((example) => {
    example.querySelectorAll<HTMLButtonElement>(".example-toolbar-control").forEach((tab) => {
      tab.addEventListener("click", () => {
        const tabName = tab.dataset.tab!;
        example
          .querySelectorAll(".example-toolbar-control")
          .forEach((t) => t.classList.toggle("active", (t as HTMLElement).dataset.tab === tabName));
        example
          .querySelectorAll(".sigma-example-panel")
          .forEach((p) => p.classList.toggle("active", (p as HTMLElement).dataset.panel === tabName));
      });
    });
  });
</script>
