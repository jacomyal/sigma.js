{
  "name": "@sigma/root",
  "description": "A JavaScript library aimed at visualizing graphs of thousands of nodes and edges.",
  "homepage": "https://www.sigmajs.org",
  "bugs": "http://github.com/jacomyal/sigma.js/issues",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "npm exec --workspaces -- npx rimraf node_modules && npx rimraf node_modules",
    "build": "preconstruct build && npm run build-bundle --workspace=sigma",
    "prettify": "prettier --write .",
    "lint": "eslint .",
    "check": "npm run lint && npm run check --workspaces --if-present",
    "test": "npm run test:unit && npm run test:type && npm run test:e2e",
    "test:unit": "vitest run --project '!*:types'",
    "test:type": "vitest run --project '*:types'",
    "test:e2e": "npm run test:e2e --workspace=@sigma/browser-tests",
    "start": "preconstruct dev && npm run start --workspace=@sigma/website",
    "createPackage": "ts-node bin/create-package.ts",
    "postinstall": "preconstruct dev",
    "postpublish": "preconstruct dev",
    "website:build": "npm run build --workspace=@sigma/website",
    "prepublishOnly": "npm run test && npm run build && npm run lint"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@preconstruct/cli": "^2.8.13",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "lerna": "^9.0.7",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "preconstruct": {
    "packages": [
      "packages/sigma",
      "packages/node-border",
      "packages/node-image",
      "packages/node-piechart",
      "packages/layer-leaflet",
      "packages/layer-maplibre",
      "packages/layer-webgl",
      "packages/export-image",
      "packages/utils"
    ],
    "exports": {
      "importConditionDefaultExport": "default"
    }
  }
}
